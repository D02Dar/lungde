  "cards": [
    {
      "dot": "cyan",
      "title": "双路径测量",
      "items": [
        "Realtime 在浏览器内即时计算；Offline 在后端从原始视频独立重算",
        "对齐与 Primary 轨迹只用于复核展示，不回写正式 Vt、Vc、ratio 或 RR"
      ]
    },
    {
      "dot": "emerald",
      "title": "可追溯记录",
      "items": [
        "浏览器 IndexedDB 保留原始录像、ROI、相位、样本、结果与证据时间戳",
        "后端 SQLite + 文件目录保留分析记录、上传视频与证据帧"
      ]
    },
    {
      "dot": "amber",
      "title": "部署边界",
      "items": [
        "首选单一 HTTPS 学校服务器：静态 Vue 与 /api 反向代理到 FastAPI",
        "当前没有跨用户或跨设备同步；多实例前需认证、所有权校验与共享存储"
      ]
    }
